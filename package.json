{
  "name": "@vbcdx/dev-agents",
  "version": "0.1.0",
  "description": "Installer for the sixteen canonical VBCDX development agents. One canonical prompt and role descriptor per role, rendered deterministically for DSH, Claude Code, Codex, and OpenCode. Installs useful agents with or without service credentials; never configures MCP servers itself.",
  "type": "module",
  "bin": {
    "vbcdx-dev-agents": "bin/vbcdx-dev-agents.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src",
    "assets",
    "skills",
    "cordis.patch.yml",
    ".env.example",
    "README.md"
  ],
  "dsh": {
    "plugin": true,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test",
    "start": "node bin/a2a-server.js",
    "lint": "node --check bin/vbcdx-dev-agents.js && node --check bin/a2a-server.js"
  },
  "keywords": [
    "vbcdx",
    "agents",
    "dsh",
    "claude-code",
    "codex",
    "opencode",
    "installer"
  ],
  "author": "VBCDX",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "smol-toml": "^1.8.0",
    "yaml": "^2.9.1"
  }
}
