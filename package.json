{
  "name": "@vbcdx/dev-agents-plugin",
  "version": "0.1.1",
  "description": "The dev agent pack for vbcdx: sixteen development roles (prompt + descriptor each) and their skills, installed by vbcdx into Claude Code, Codex, OpenCode or Hermes Agent. Teams layer their own process on through overlay slots and variables.",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./vbcdx-pack.json": "./vbcdx-pack.json"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "assets",
    "skills",
    "plugins",
    ".claude-plugin",
    "vbcdx-pack.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "lint": "node scripts/lint.mjs"
  },
  "keywords": [
    "vbcdx",
    "vbcdx-pack",
    "agents",
    "claude-code",
    "codex",
    "opencode",
    "hermes"
  ],
  "author": "VBCDX",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VBCDX/dev-agents-plugin.git"
  },
  "homepage": "https://github.com/VBCDX/dev-agents-plugin#readme",
  "bugs": {
    "url": "https://github.com/VBCDX/dev-agents-plugin/issues"
  }
}
